<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<package format="3">
  <name>mission_nodes</name>
  <version>1.0.0</version>
  <description>
    ROS 2 nodes for the autonomous UAV/UGV QR mission: QR perception, world
    model, drone exploration, mission management and rover path following.
    All mission logic lives in mission_core; these nodes are the ROS adapters.
  </description>
  <maintainer email="merterdoganyildirim@gmail.com">Mert Erdogan Yildirim</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>mission_core</depend>
  <depend>mission_interfaces</depend>
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>cv_bridge</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
