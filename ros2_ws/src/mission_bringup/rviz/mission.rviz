Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Tree Height: 700
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 24
      Color: 100; 100; 100
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 1.2
      Show Names: true
      Show Axes: true
    - Class: rviz_default_plugins/Map
      Name: Observed occupancy
      Enabled: true
      Topic:
        Value: /world_model/occupancy_grid
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.7
    - Class: rviz_default_plugins/MarkerArray
      Name: World model
      Enabled: true
      Topic:
        Value: /world_model/markers
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: Rover path
      Enabled: true
      Topic:
        Value: /mission/rover_path
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color: 25; 255; 120
      Line Style: Billboards
      Line Width: 0.06
    - Class: rviz_default_plugins/Odometry
      Name: Drone odometry
      Enabled: true
      Topic:
        Value: /drone/odometry
        Reliability Policy: Best Effort
      Keep: 1
      Shape:
        Color: 255; 170; 0
        Shaft Length: 0.6
        Head Length: 0.25
    - Class: rviz_default_plugins/Odometry
      Name: Rover odometry
      Enabled: true
      Topic:
        Value: /rover/odometry
        Reliability Policy: Best Effort
      Keep: 1
      Shape:
        Color: 0; 200; 255
        Shaft Length: 0.6
        Head Length: 0.25
    - Class: rviz_default_plugins/PointCloud2
      Name: Drone lidar
      Enabled: false
      Topic:
        Value: /drone/scan/points
        Reliability Policy: Best Effort
      Size (m): 0.05
      Style: Points
    - Class: rviz_default_plugins/Image
      Name: Drone camera
      Enabled: false
      Topic:
        Value: /drone/camera/image
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Image
      Name: Rover camera
      Enabled: false
      Topic:
        Value: /rover/camera/image
        Reliability Policy: Best Effort
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 34
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.0
      Yaw: 0.9
Window Geometry:
  Height: 1000
  Width: 1500
