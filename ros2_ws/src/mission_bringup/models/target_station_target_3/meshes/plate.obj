# Unit plate for a QR target station.
# A 1x1 quad in the XY plane facing +Z, with explicit UVs so the texture
# mapping is identical in every renderer. Scaled to the plate size by the SDF.
mtllib plate.mtl
o qr_plate
v -0.5 -0.5 0.0
v  0.5 -0.5 0.0
v  0.5  0.5 0.0
v -0.5  0.5 0.0
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vn 0.0 0.0 1.0
usemtl qr_material
f 1/1/1 2/2/1 3/3/1 4/4/1
