<?xml version="1.0"?>
<sdf version="1.9">
  <!--
    Differential-drive UGV.

    base_link's origin sits on the ground plane between the drive wheels, so
    every sensor pose in this file is also the sensor's height above ground -
    which is what the static transforms in mission.launch.py and the mount
    constants in the offline harness use.
  -->
  <model name="mission_rover">
    <pose>0 0 0 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <pose>0 0 0.20 0 0 0</pose>
        <mass>9.0</mass>
        <inertia>
          <ixx>0.150</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.320</iyy><iyz>0</iyz>
          <izz>0.400</izz>
        </inertia>
      </inertial>

      <visual name="chassis">
        <pose>0 0 0.20 0 0 0</pose>
        <geometry><box><size>0.60 0.40 0.16</size></box></geometry>
        <material>
          <ambient>0.20 0.18 0.10 1</ambient>
          <diffuse>0.85 0.65 0.10 1</diffuse>
        </material>
      </visual>
      <visual name="mast">
        <pose>0.18 0 0.36 0 0 0</pose>
        <geometry><box><size>0.08 0.08 0.24</size></box></geometry>
        <material><diffuse>0.25 0.25 0.28 1</diffuse></material>
      </visual>
      <collision name="chassis_collision">
        <pose>0 0 0.20 0 0 0</pose>
        <geometry><box><size>0.60 0.40 0.16</size></box></geometry>
      </collision>

      <!-- Passive support at each end. Frictionless: a real caster swivels,
           and any drag here fights the drive wheels during a turn, which
           shows up as yaw drift in the wheel-encoder odometry. -->
      <collision name="caster_front">
        <pose>0.24 0 0.06 0 0 0</pose>
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <surface>
          <friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="caster_front_visual">
        <pose>0.24 0 0.06 0 0 0</pose>
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <material><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <collision name="caster_rear">
        <pose>-0.24 0 0.06 0 0 0</pose>
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <surface>
          <friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="caster_rear_visual">
        <pose>-0.24 0 0.06 0 0 0</pose>
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <material><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>

      <!--
        Forward camera at 0.55 m - the rover's only sensor, and it does two
        jobs. It verifies the station's QR code at the end of a leg, and while
        driving it is the emergency-stop sensor: obstacle bases are found in
        the same frames by intersecting the bottom of each silhouette with the
        ground plane, which is where a planar safety lidar used to sit. No
        ranging device is fitted to this vehicle either.

        At the 1.8 m nominal standoff the 0.80 m plate spans roughly 0.66 of
        the image height, so it fits with margin; moving it much lower or
        closer clips the code and the rover can never confirm the station.
        Mirrored by ROVER_CAMERA_MOUNT and by rover.safety_camera_forward_offset_m.
      -->
      <sensor name="front_camera" type="camera">
        <pose>0.22 0 0.55 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>6</update_rate>
        <visualize>false</visualize>
        <topic>/rover/camera/image</topic>
        <gz_frame_id>rover/camera_optical_frame</gz_frame_id>
        <camera>
          <!-- Must match rover.camera in config/mission.yaml. -->
          <horizontal_fov>1.20</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.05</near><far>30</far></clip>
          <optical_frame_id>rover/camera_optical_frame</optical_frame_id>
        </camera>
      </sensor>

    </link>

    <link name="left_wheel">
      <pose>0 0.23 0.12 -1.5707963 0 0</pose>
      <inertial>
        <mass>0.7</mass>
        <inertia>
          <ixx>0.0031</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0031</iyy><iyz>0</iyz>
          <izz>0.0050</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry><cylinder><radius>0.12</radius><length>0.06</length></cylinder></geometry>
        <material><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.12</radius><length>0.06</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
        </surface>
      </collision>
    </link>

    <link name="right_wheel">
      <pose>0 -0.23 0.12 -1.5707963 0 0</pose>
      <inertial>
        <mass>0.7</mass>
        <inertia>
          <ixx>0.0031</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0031</iyy><iyz>0</iyz>
          <izz>0.0050</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry><cylinder><radius>0.12</radius><length>0.06</length></cylinder></geometry>
        <material><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.12</radius><length>0.06</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
        </surface>
      </collision>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.46</wheel_separation>
      <wheel_radius>0.12</wheel_radius>
      <!-- Headroom above rover.max_linear_velocity/max_angular_velocity so the
           follower's limits bind, not the plugin's. -->
      <max_linear_acceleration>1.5</max_linear_acceleration>
      <max_angular_acceleration>4.0</max_angular_acceleration>
      <topic>/model/mission_rover/cmd_vel</topic>
      <!-- DiffDrive's own odometry is dead-reckoned from wheel encoders and
           is deliberately NOT used: over a 15 m drive with turns it drifted
           far enough that the rover tracked its path perfectly (cross-track
           0.00 m) while physically sitting 0.27 m inside the planner's
           clearance, tripping the emergency stop, and placed a QR observation
           1.51 m from where the drone had seen the same station - just past
           the association radius, which split one station into two and
           triggered DUPLICATE_QR. Published to an unbridged topic so the
           plugin stays happy and nothing consumes it. -->
      <odom_topic>/model/mission_rover/wheel_odometry</odom_topic>
      <tf_topic>/model/mission_rover/wheel_tf</tf_topic>
      <frame_id>rover/odom</frame_id>
      <child_frame_id>rover/base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <!-- Absolute localisation, matching what the drone already uses. A real
         rover would get this from RTK GPS, a motion-capture rig or AMCL
         against the map; in simulation it stands in for all of them. This is
         *self*-localisation only - target positions are still perceived. -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>rover/odom</odom_frame>
      <robot_base_frame>rover/base_link</robot_base_frame>
      <odom_topic>/model/mission_rover/odometry</odom_topic>
      <tf_topic>/model/mission_rover/tf</tf_topic>
      <dimensions>2</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <!-- No JointStatePublisher: there is no robot_description or
         robot_state_publisher in this stack, so wheel joint states would be an
         unconsumed topic. RViz visualises the rover from its odometry. -->
  </model>
</sdf>
